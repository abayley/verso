{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "verso",
            "runtimeExecutable": "make",
            "runtimeArgs": [
                "run-verso"
            ],
            "port": 8080
        },
        {
            "name": "verso-search-demo",
            "runtimeExecutable": "env",
            "runtimeArgs": [
                "MICROHTTP_CONFIG=build/search-demo.conf",
                "make",
                "run-verso"
            ],
            "port": 8081
        },
        {
            "name": "mockups",
            "runtimeExecutable": "python3",
            "runtimeArgs": [
                "-m",
                "http.server",
                "8123",
                "--bind",
                "127.0.0.1",
                "--directory",
                "docs/mockups"
            ],
            "port": 8123
        },
        {
            "name": "basecoat-lit-spike",
            "runtimeExecutable": "python3",
            "runtimeArgs": [
                "-m",
                "http.server",
                "5176",
                "--bind",
                "127.0.0.1",
                "--directory",
                "spike/basecoat-lit"
            ],
            "port": 5176
        }
    ]
}
