cabal-version:      2.4
name:               socket-sender
version:            0.1.0.0
synopsis:           GHC blocking-socket load generator for the socket saturation bench.

executable socket-sender
    main-is:          Main.hs
    build-depends:    base, bytestring, network
    default-language: Haskell2010
    ghc-options:      -O2

executable socket-drain
    main-is:          Drain.hs
    build-depends:    base, bytestring, network
    default-language: Haskell2010
    ghc-options:      -O2
