  "cards": [
    {
      "dot": "cyan",
      "title": "Framework",
      "items": [
        "MicroHttp.* has no dependency on Verso.*",
        "Iteratee-based streaming HTTP on plain sockets",
        "Router serves the editor bundle as static files"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage",
      "items": [
        "Document tree is a git working tree; publish commits it",
        "Moves and deletes are journalled for undo and replay",
        "Link index is rebuilt on demand, never per operation"
      ]
    },
    {
      "dot": "violet",
      "title": "Search",
      "items": [
        "Changes are queued and indexed off the request path",
        "Concordance tokenises and embeds in Haskell",
        "lancedb is linked in-process through a C shim"
      ]
    }
  ]
