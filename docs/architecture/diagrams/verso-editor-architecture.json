  "cards": [
    {
      "dot": "cyan",
      "title": "Content model",
      "items": [
        "remark parses; content extensions own their block and inline payloads",
        "One EditorDocument feeds Tiptap and is serialised back to Markdown",
        "Badges, footnotes, tables, images, alerts, collapsibles, raw HTML, reference links"
      ]
    },
    {
      "dot": "emerald",
      "title": "Editing",
      "items": [
        "Visual and source surfaces share the EditingSurface command set",
        "Floating surfaces and side panels are Lit elements styled with Basecoat",
        "Mermaid is a separately loaded lazy bundle"
      ]
    },
    {
      "dot": "violet",
      "title": "Server I/O",
      "items": [
        "Autosave debounces, then PUTs raw Markdown to /drafts",
        "One ServerClient validates every JSON response before the UI sees it",
        "Network failure collapses to a single retry state"
      ]
    }
  ]
