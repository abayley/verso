# MicroHttp configuration (RFC-0011).
#
# Copy to micro-http.conf (or point MICROHTTP_CONFIG at it) and edit. A missing
# file means built-in defaults; a malformed file refuses to start. Any key can
# be overridden by an environment variable named MICROHTTP_<KEY> (uppercased),
# which wins over the file.

# --- server (mapped to Settings) ---
host = 0.0.0.0
port = 8080
backlog = 16
max_active_handlers = 32
max_header_bytes = 8192
max_body_bytes = 1048576
read_buffer_bytes = 8192
idle_read_timeout_micros = 30000000
idle_write_timeout_micros = 30000000

# --- application ---
access_log = build/access.log
client_error_log = build/client-errors.log
document_root = data/documents

# A comma-separated list of "<url-prefix> <filesystem-root>" mounts.
static_mounts = /static/editor static/editor

# --- document tree mode (RFC-0026+) ---
# Set document_tree_root to serve and edit a MkDocs-style tree in place (ADR-045),
# instead of the flat document_root above. The remaining keys take effect in this mode;
# their defaults are shown. operation_log and trash_root must be OUTSIDE the tree but on
# the same filesystem (RFC-0027/0028). link_index is the persisted link graph used by
# move/delete (RFC-0029); rebuilt automatically if absent/stale/corrupt, and by
# POST /index/refresh after a corpus re-export.
# document_tree_root = data/tree
# operation_log = data/operation_log
# trash_root = data/trash
# link_index = data/link_index
