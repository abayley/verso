{
    "private": true,
    "type": "module",
    "scripts": {
        "editor:build": "bun scripts/build-editor.mjs",
        "editor:check": "bun run editor:lint && bun run editor:typecheck && bun run editor:test && bun run editor:build",
        "editor:format": "biome check --write src/Verso/Editor test/editor package.json tsconfig.json biome.json knip.json",
        "editor:knip": "knip",
        "editor:lint": "biome check src/Verso/Editor test/editor package.json tsconfig.json biome.json knip.json && bun run editor:knip",
        "editor:test": "vitest run --dom",
        "editor:typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@awesome.me/webawesome": "^3.8.0",
        "@biomejs/biome": "^2.4.16",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/language": "^6.12.3",
        "@codemirror/state": "^6.6.0",
        "@lezer/highlight": "^1.2.3",
        "@tiptap/core": "^3.26.0",
        "@tiptap/extension-code-block-lowlight": "3.26.0",
        "@tiptap/extension-heading": "^3.26.0",
        "@tiptap/markdown": "^3.26.0",
        "@tiptap/starter-kit": "^3.26.0",
        "@types/mdast": "^4.0.4",
        "codemirror": "^6.0.2",
        "happy-dom": "^20.10.2",
        "knip": "^6.16.1",
        "lowlight": "^3.3.0",
        "playwright": "^1.60.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-stringify": "^11.0.0",
        "typescript": "^6.0.3",
        "unified": "^11.0.5",
        "vitest": "^4.1.8"
    },
    "dependencies": {
        "@tiptap/extension-table": "^3.26.0",
        "lit": "^3.3.3"
    }
}
