{
    "private": true,
    "type": "module",
    "scripts": {
        "editor:build": "bun scripts/build-editor.mjs",
        "editor:check": "bun run editor:lint && bun run editor:typecheck && bun run editor:test && bun run editor:build",
        "editor:format": "biome check --write src/TestApp/Editor test/editor package.json tsconfig.json biome.json",
        "editor:lint": "biome check src/TestApp/Editor test/editor package.json tsconfig.json biome.json",
        "editor:test": "vitest run --dom",
        "editor:typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@codemirror/lang-markdown": "^6.5.0",
        "@tiptap/core": "^3.26.0",
        "@tiptap/markdown": "^3.26.0",
        "@tiptap/starter-kit": "^3.26.0",
        "@types/mdast": "^4.0.4",
        "codemirror": "^6.0.2",
        "happy-dom": "^20.10.2",
        "playwright": "^1.60.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-stringify": "^11.0.0",
        "typescript": "^6.0.3",
        "unified": "^11.0.5",
        "vitest": "^4.1.8"
    }
}
