{
    "name": "verso-editor",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun build-editor.mjs",
        "check": "bun run lint && bun run typecheck && bun run moebius && bun run test && bun run build",
        "format": "biome check --write src test moebius package.json tsconfig.json biome.json knip.json vitest.config.ts",
        "knip": "knip",
        "lint": "biome check src test moebius package.json tsconfig.json biome.json knip.json vitest.config.ts && bun run knip",
        "moebius": "bun moebius/port.ts --check",
        "test": "vitest run --dom",
        "typecheck": "tsc --noEmit && tsc --noEmit -p moebius"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/state": "6.6.0",
        "@lezer/highlight": "1.2.3",
        "@tiptap/core": "3.26.0",
        "@tiptap/extension-code-block-lowlight": "3.26.0",
        "@tiptap/extension-heading": "3.26.0",
        "@tiptap/markdown": "3.26.0",
        "@tiptap/starter-kit": "3.26.0",
        "@types/mdast": "4.0.4",
        "@types/node": "25.9.2",
        "basecoat-css": "1.0.2",
        "codemirror": "6.0.2",
        "happy-dom": "20.10.2",
        "knip": "6.16.1",
        "lowlight": "3.3.0",
        "mermaid": "11.16.0",
        "playwright": "1.60.0",
        "rehype-stringify": "10.0.1",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "remark-stringify": "11.0.0",
        "typescript": "6.0.3",
        "unified": "11.0.5",
        "vitest": "4.1.8"
    },
    "dependencies": {
        "@codemirror/view": "6.43.0",
        "@fontsource-variable/roboto": "5.3.0",
        "@fontsource-variable/roboto-mono": "5.3.0",
        "@tiptap/extension-table": "3.26.1",
        "lit": "3.3.3"
    },
    "overrides": {
