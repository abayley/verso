+// Counts result rows after conversion to Arrow, requiring `required_col`
+// to be present in the result schema (pass nullptr to skip the check).
+static size_t count_result_rows(LanceDBQueryResult* query_result, const char* required_col) {
+  FFI_ArrowArray** result_arrays = nullptr;
+  FFI_ArrowSchema* result_schema = nullptr;
+  size_t count = 0;
+  char* error_message = nullptr;
+  const auto result = lancedb_query_result_to_arrow(
+      query_result, &result_arrays, &result_schema, &count, &error_message);
+  REQUIRE(result == LANCEDB_SUCCESS);
+  REQUIRE(error_message == nullptr);
+
+  if (required_col != nullptr) {
+    auto* schema = reinterpret_cast<ArrowSchema*>(result_schema);
+    bool found = false;
+    for (int64_t i = 0; i < schema->n_children; i++) {
+      if (std::string(schema->children[i]->name) == required_col) {
+        found = true;
+      }
+    }
+    REQUIRE(found);
+  }
+
+  size_t sum_rows = 0;
+  for (size_t i = 0; i < count; i++) {
+    sum_rows += reinterpret_cast<ArrowArray*>(result_arrays[i])->length;
+  }
+  lancedb_free_arrow_arrays(result_arrays, count);
+  lancedb_free_arrow_schema(result_schema);
+  return sum_rows;
+}
