+/// Build a FullTextSearchQuery from C strings, or record an error.
+///
+/// # Safety
+/// - `text` must be a valid null-terminated C string
+/// - `columns` may be null (search all indexed columns) or point to
+///   `num_columns` valid C strings
+unsafe fn build_fts_query(
+    text: *const c_char,
+    columns: *const *const c_char,
+    num_columns: usize,
+    error_message: *mut *mut c_char,
+) -> Option<FullTextSearchQuery> {
+    if text.is_null() {
+        set_invalid_argument_message(error_message);
+        return None;
+    }
+    let text_str = match CStr::from_ptr(text).to_str() {
+        Ok(s) => s.to_string(),
+        Err(_) => {
+            set_invalid_argument_message(error_message);
+            return None;
+        }
+    };
+    let mut fts = FullTextSearchQuery::new(text_str);
+    if !columns.is_null() && num_columns > 0 {
+        let mut cols = Vec::with_capacity(num_columns);
+        for i in 0..num_columns {
+            let col_ptr = *columns.add(i);
+            if col_ptr.is_null() {
+                set_invalid_argument_message(error_message);
+                return None;
+            }
+            match CStr::from_ptr(col_ptr).to_str() {
+                Ok(s) => cols.push(s.to_string()),
+                Err(_) => {
+                    set_invalid_argument_message(error_message);
+                    return None;
+                }
+            }
+        }
+        fts = match fts.with_columns(&cols) {
+            Ok(f) => f,
+            Err(_) => {
+                set_unknown_error_message(error_message);
+                return None;
+            }
+        };
+    }
+    Some(fts)
+}
+
+/// Set a full-text (BM25) match query on a plain query
+///
+/// Requires an FTS index on the searched column(s). Executing the query then
+/// returns rows ranked by BM25 relevance in a `_score` column.
+///
+/// # Safety
+/// - `query` must be a valid pointer returned from `lancedb_query_new`
+/// - `text` must be a valid null-terminated C string
+/// - `columns` may be NULL (search all FTS-indexed columns) or point to
+///   `num_columns` valid null-terminated C strings
+/// - `error_message` can be NULL to ignore detailed error messages
+#[no_mangle]
+pub unsafe extern "C" fn lancedb_query_full_text_search(
+    query: *mut LanceDBQuery,
+    text: *const c_char,
+    columns: *const *const c_char,
+    num_columns: usize,
+    error_message: *mut *mut c_char,
+) -> LanceDBError {
+    if query.is_null() {
+        set_invalid_argument_message(error_message);
+        return LanceDBError::InvalidArgument;
+    }
+    match build_fts_query(text, columns, num_columns, error_message) {
+        Some(fts) => {
+            (*query).full_text_search = Some(fts);
+            LanceDBError::Success
+        }
+        None => LanceDBError::InvalidArgument,
+    }
+}
