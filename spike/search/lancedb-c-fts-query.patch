+    }) {
+        Ok(stream) => {
+            let result = Box::new(LanceDBQueryResult {
+                inner: Box::new(stream),
+            });
+            Box::into_raw(result)
+        }
+        Err(_) => ptr::null_mut(),
+    }
+}
